{
  "manifest_version": 3,
  "name": "Smart Link Creator",
  "version": "1.0",
  "description": "Automatically converts brand names and important keywords into clickable search links",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Link Creator"
  }
  
  // ,
  // "icons": {
  //   "16": "icon16.png",
  //   "48": "icon48.png",
  //   "128": "icon128.png"
  // }
}